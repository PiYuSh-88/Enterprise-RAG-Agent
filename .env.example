# ══════════════════════════════════════════════════════════════════════════════
# .env.example — committed with BLANK values.
# Copy to .env and fill in real values. .env is gitignored and must NEVER
# be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="SmartPark RAG Agent"
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=

# ── API Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/ragdb

# ── Qdrant (Vector Store) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_documents

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.2

# ── Document Processing ───────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=50

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
